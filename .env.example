# Configuration OVH MX Plan. Pour Email Pro / Exchange, utiliser le serveur indiqué dans votre espace OVH.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@kodbars.fr
SMTP_PASSWORD=

# Clé publique au build + secret au runtime : protection antispam obligatoire en production.
# Créer un widget Cloudflare Turnstile pour kodbars.fr (et localhost pour les essais).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
